 "groups": [
  {
   "id": "up",
   "title": "Look Up",
   "note": "Kept as it was. Wonder: kids pointing at the Atomium, a man's arm raised to a kite between the towers, a couple under a needle with a giant insect on top, a crowd tilting their heads to a painted ceiling. One gesture in four cities.",
   "ids": [
    "51",
    "44",
    "50",
    "59"
   ]
  },
  {
   "id": "hand",
   "title": "Hand in Hand",
   "note": "Adults guiding children into the city, and slowly letting go. A man reaches for a child's hand by the lake; a mother holds one child while another rides on shoulders; a man points a child towards a sign that says 'we are building something big'; finally a child races ahead on a scooter, the parent's cargo bike behind. Care, then independence. 03 and 54 are colour.",
   "ids": [
    "03",
    "54",
    "46",
    "65"
   ]
  },
  {
   "id": "alone",
   "title": "Alone in the Crowd",
   "note": "Solitude inside the busy city. A single figure under an arch in the rain; a man on his phone while shoppers blur past; a man leaning on a shutter while people stream by; one tiny figure on the Galleria roof. Each person is surrounded, but nobody is with them.",
   "ids": [
    "13",
    "25",
    "41",
    "02"
   ]
  },
  {
   "id": "together",
   "title": "Together",
   "note": "The opposite of 'Alone in the Crowd': bodies close to each other. Old friends on a bench watching bocce; chefs with their arms around each other; two women dancing at a concert; couples dancing on the steps. Read it straight after 'Alone in the Crowd'.",
   "ids": [
    "14",
    "08",
    "06",
    "61"
   ]
  },
  {
   "id": "want",
   "title": "What We're Sold",
   "note": "People and the images made to sell to them. A Chanel model checks her watch above a man hauling cardboard; a child drags her mother towards a giant shoe under a billboard face; women pass a mannequin in the coat they are all wearing; a mural boy holds his face in despair while passers-by look at their phones. Luxury, labour, desire, indifference. Mostly colour (43 is B&W).",
   "ids": [
    "20",
    "43",
    "10",
    "49"
   ]
  },
  {
   "id": "generations",
   "title": "Generations",
   "note": "Young lives at the feet of old things. An old woman watches a boy cross a white installation; a toddler stands before a classical statue; two girls in First Communion veils pass under the castle gate; young women laugh under a bronze horseman at sunset. Tradition, inheritance, and the new generation living inside it.",
   "ids": [
    "32",
    "31",
    "21",
    "60"
   ]
  },
  {
   "id": "dark",
   "title": "Into the Dark",
   "note": "Curiosity pulling people into black spaces. Heads pushed into a porthole; faces in a slit window; a child crouched inside a black box; a man stepping through a dark doorway. The sequence moves from looking in to going in.",
   "ids": [
    "29",
    "27",
    "26",
    "30"
   ]
  },
  {
   "id": "rhythm",
   "title": "Falling into Line",
   "note": "People unconsciously taking on the rhythm of the architecture around them: visitors in white standing like the white panels beside them; walkers lined up in a strip of light under Gothic windows; a woman striding past a run of arcades; figures between the columns of the Bourse.",
   "ids": [
    "33",
    "12",
    "16",
    "55"
   ]
  },
  {
   "id": "loose",
   "title": "Breaking Loose",
   "note": "Moments of release in controlled spaces. A bird flies free above a crowd held back by a fence; pigeons scatter over bikes dropped on the ground; a boy spins in an empty square under a storm sky; kids climb a ramp that wasn't built for climbing.",
   "ids": [
    "11",
    "17",
    "48",
    "58"
   ]
  },
  {
   "id": "companions",
   "title": "Companions",
   "note": "People and their dogs. A dog peers out of a bag at passing legs; a dog in a backpack looks straight at the camera; a man plays with his dog under the vertical forest; a man and his dog watch boys play football.",
   "ids": [
    "07",
    "24",
    "45",
    "15"
   ]
  },
  {
   "id": "jokes",
   "title": "Small Jokes",
   "note": "The city's coincidences. A man waves next to a photo booth with someone's legs sticking out; a woman perches in the street under a painted woman on the wall; a giant toy unicorn stares out of a shop window; a toddler stretches in boredom while adults kneel to photograph the Galleria.",
   "ids": [
    "62",
    "57",
    "47",
    "19"
   ]
  },
  {
   "id": "spectacle",
   "title": "Spectacle",
   "note": "Big shows, small audiences. A crowd behind railings under a giant laughing face; men beneath a towering printed figure; viewers circling a yacht model in the dark; a chandelier hanging over a hall of rigging.",
