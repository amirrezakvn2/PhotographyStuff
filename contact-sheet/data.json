   ]
  },
  {
   "id": "doubles",
   "title": "Doubles",
   "note": "Colour. A real person echoes a painted or printed one: a woman sitting in the street under a painted woman on the wall, a mannequin in a black coat between women in black coats, passers-by under a mural boy holding his face, a billboard model above a man carrying cardboard.",
   "ids": [
    "57",
