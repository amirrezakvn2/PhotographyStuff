 "groups": [
  {
   "id": "arches",
   "title": "Arches",
   "note": "Four doorways: a figure under an arch in Turin, two veiled girls under the Castello gate, a man beside a photo booth, tiny walkers under Gothic windows. Same shape, four kinds of waiting.",
   "ids": [
    "13",
    "21",
    "62",
    "12"
   ]
  },
  {
   "id": "box",
   "title": "Inside the Box",
   "note": "Design Week's dark wooden installations. Every frame has a hole in a black wall, and someone in it: crouching, looking out, peeping in, stepping through.",
   "ids": [
    "26",
    "27",
    "29",
    "30"
   ]
  },
  {
   "id": "white",
   "title": "White Rooms",
   "note": "The opposite of 'Inside the Box': pale installations, children and visitors drifting through white curves, panels and ribbons.",
   "ids": [
