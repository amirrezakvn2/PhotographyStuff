 "groups": [
  {
   "id": "up",
   "title": "Look Up",
   "note": "Everyone is looking or pointing above the frame: kids pointing at the Atomium, a man's arm raised towards a kite between the towers, a couple under a needle with a giant insect on top, a crowd tilting their heads at a painted ceiling. Same gesture in four cities. Sequence goes from outdoor and open to indoor and closed.",
   "ids": [
    "51",
    "44",
    "50",
    "59"
   ]
  },
  {
   "id": "audience",
   "title": "Audience",
   "note": "People watching something, mostly from behind: old men on a bench watching bocce, a man's bald head against a concert, a crowd behind railings under a giant laughing face, people on a wall watching dancers below. We watch them watching.",
   "ids": [
    "14",
    "06",
    "28",
    "61"
   ]
  },
  {
   "id": "hidden",
   "title": "Hiding Places",
   "note": "Bodies half-hidden inside boxes: a child crouched in a black installation, faces in a slit, people with their heads in a porthole, and someone's legs sticking out of a photo booth while a man waves outside. The booth turns the series into a joke at the end.",
   "ids": [
    "26",
    "27",
    "29",
    "62"
   ]
  },
  {
   "id": "thresholds",
   "title": "Small Under Arches",
   "note": "Arches and a tiny human in each: one figure and a pigeon under a Turin arch, two veiled girls under the Castello gate, specks of people under Gothic windows, a single figure on the Galleria roof.",
   "ids": [
    "13",
    "21",
    "12",
    "02"
   ]
  },
  {
   "id": "white",
   "title": "Children in White Rooms",
   "note": "Pale Design Week installations, each with a child moving through them while adults stand still: a boy crossing white curves, a kid among panels, a child behind ribbons, a toddler at a white statue.",
   "ids": [
    "32",
    "33",
    "34",
    "31"
   ]
  },
  {
   "id": "play",
   "title": "Running Light",
   "note": "Children in hard sunlight with long shadows: a scooter, kids climbing a ramp, a boy running under a storm sky, birds and dropped bicycles in a Veneto street.",
   "ids": [
    "65",
    "58",
    "48",
    "17"
   ]
  },
  {
   "id": "display",
   "title": "On Display",
   "note": "Things made to be looked at, bigger than the people looking: a giant shoe, a yacht model in a black pool, a huge printed figure, a chandelier in a hall of rigging.",
   "ids": [
    "43",
    "39",
    "37",
    "38"
   ]
  },
  {
   "id": "reflections",
   "title": "Two Layers",
   "note": "Glass that puts two places in one frame: the Duomo floating on a shop window, a caf\u00e9 inside a pane, a unicorn toy and the street outside, people walking through hanging posters.",
